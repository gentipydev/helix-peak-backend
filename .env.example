NCBI_EMAIL=you@example.com

# The catalog database. Optional: unset means no cache and no catalog, and
# /gene/{id}/{gene} keeps answering from NCBI exactly as it did.
#
# Use the SESSION pooler, port 5432. Not the direct db.<ref>.supabase.co host,
# which resolves to IPv6 only and Render cannot reach; not the transaction
# pooler on 6543, which disallows the prepared statements psycopg uses.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# The same project as a REST origin, used to build the public storage URLs the
# client fetches track blobs from. Dashboard: Settings -> API -> Project URL.
# SUPABASE_URL=https://<ref>.supabase.co

# Phase 6: proteins resolved on demand by the resolver on Modal
# (pipeline/resolver/README.md). All optional. The wake URL is the one
# `modal deploy pipeline/resolver/modal_app.py` prints; the key and secret are a
# Modal proxy auth token (modal.com -> Settings -> Proxy Auth Tokens), which can
# start a sweep and nothing else. Unset, requests resolve on the resolver's
# five-minute schedule. RESOLVES_PER_DAY caps a day's requests (default 50).
# MODAL_WAKE_URL=https://<workspace>--helix-peak-resolver-wake.modal.run
# MODAL_KEY=wk-...
# MODAL_SECRET=ws-...
# RESOLVES_PER_DAY=50

# Only `tool/upload_tracks.py` needs a service_role key, and it reads it from
# its own command environment rather than from here -- the deployed service
# builds public URLs and reaches its rows over DATABASE_URL, so it holds no
# Supabase credential. Dashboard: Settings -> API keys -> service_role.
#   SUPABASE_SERVICE_KEY=... python3 tool/upload_tracks.py --kind clinvar
